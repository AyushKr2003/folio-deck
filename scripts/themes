#!/usr/bin/env python3
"""Prints one JSON line per Omarchy theme for the deck's theme cards: its id,
display title, preview picture, light/dark mode, where it comes from and the
five chips (primary, secondary, tertiary, container, surface) read from its
colors.toml. Lines "#current <id>" give the theme in use.
  scripts/themes
"""
import colorsys, json, os, sys, tomllib

home = os.path.expanduser("~")
omarchy = os.environ.get("OMARCHY_PATH", home + "/.local/share/omarchy")
roots = [("user", home + "/.config/omarchy/themes"), ("built-in", omarchy + "/themes")]

def hue(hex_):
    r, g, b = (int(hex_[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    return 999 if s < 0.12 else h * 360

def gap(a, b):
    d = abs(a - b) % 360
    return 360 - d if d > 180 else d

themes = {}
for origin, root in roots:
    try: names = os.listdir(root)
    except OSError: continue
    for n in names:
        d = os.path.join(root, n)
        if os.path.isdir(d) and n not in themes:       # user copies win
            themes[n] = (origin, d)

for n in sorted(themes):
    origin, d = themes[n]
    # A user theme may only overlay the built-in one of the same name.
    base = os.path.join(omarchy, "themes", n)
    toml = next((p for p in (d + "/colors.toml", base + "/colors.toml") if os.path.isfile(p)), None)
    if not toml: continue
    try:
        with open(toml, "rb") as f: c = tomllib.load(f)
    except Exception: continue
    preview = next((p for p in (os.path.join(x, f) for x in (d, base) for f in ("preview.png", "preview.jpg", "preview.jpeg", "preview.webp")) if os.path.isfile(p)), "")
    # Its wallpapers: your own for it, then the theme's (a user copy's, else
    # the built-in one's). Pictures only; the card can't show a video.
    pics, seen = [], set()
    for bd in (home + "/.config/omarchy/backgrounds/" + n, d + "/backgrounds", base + "/backgrounds"):
        try: fs = sorted(os.listdir(bd))
        except OSError: continue
        for f in fs:
            if f.lower().endswith((".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")) and f not in seen:
                seen.add(f); pics.append(os.path.join(bd, f))
    accent = c.get("accent") or c.get("blue") or "#888888"
    pool = [c[k] for k in ("blue", "magenta", "cyan", "green", "orange", "yellow", "red") if k in c]
    far = sorted(pool, key=lambda x: -gap(hue(x), hue(accent)))
    secondary = next((x for x in pool if x.lower() != accent.lower() and gap(hue(x), hue(accent)) > 18), accent)
    tertiary = next((x for x in far if x != secondary and x.lower() != accent.lower()), secondary)
    surface = c.get("background", "#000000")
    print(json.dumps({
        "id": n, "title": n.replace("-", " ").title(), "dir": d, "preview": preview, "backgrounds": pics,
        "mode": c.get("mode", "dark"), "origin": origin,
        "mtime": int(os.path.getmtime(d)),
        "roles": {"primary": accent.upper(), "secondary": secondary.upper(), "tertiary": tertiary.upper(),
                  "container": c.get("lighter_background", surface).upper(), "surface": surface.upper(), "hue": hue(accent)},
    }))

try: print("#current " + open(home + "/.local/state/omarchy/current/theme.name").read().strip())
except OSError: pass
